      "properties": {
        "schema": {
          "const": 1
        },
        "protocol_sha256": {
          "const": "258087a02ea74cb8ab8a1daba55af68f68fd273f0c089c51164b52dc81179db2"
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflow_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "run_attempt": {
          "const": 1
