          "const": "bb5f8ccce0cf154af79ad020167071a7a83212016611adc267bc29f6ac4d27e9"
        },
        "status": {
          "enum": [
            "UNOBSERVED",
            "HTTP_200",
            "HTTP_301",
            "HTTP_302",
            "HTTP_303",
            "HTTP_307",
            "HTTP_308",
            "OTHER_HTTP_STATUS"
