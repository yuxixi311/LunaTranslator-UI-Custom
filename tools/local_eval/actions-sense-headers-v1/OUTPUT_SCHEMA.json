{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Closed header-only diagnostic receipt and failure envelope",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_body_read_calls",
        "authority",
        "cleanup",
        "current_policy_outcome",
        "failure",
        "header_block_complete",
        "host_class",
        "initial_exchange_intents",
        "location_form",
        "loopback_http_requests",
        "protocol_sha256",
        "redirects_followed",
        "request_send_complete",
        "request_sha256",
        "run_attempt",
        "run_id",
        "schema",
        "source_commit",
        "source_manifest_sha256",
        "status",
        "workflow_commit"
