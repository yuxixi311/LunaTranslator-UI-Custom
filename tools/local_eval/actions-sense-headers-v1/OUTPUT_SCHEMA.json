  "x-runtime-invariants": [
    "All seven identity bindings must equal admitted owner binding, with strict Python types; JSON booleans are not integers.",
    "source_commit differs from workflow_commit.",
    "header_block_complete=true implies request_send_complete=true,initial_exchange_intents=1,status is observed.",
    "request_send_complete=true implies initial_exchange_intents=1.",
    "Canonical ASCII JSON plus one LF,at most2048 bytes per frame; no extra fields.",
    "Unbound failure envelope is not evidence of zero requests or denied admission."
  ]
