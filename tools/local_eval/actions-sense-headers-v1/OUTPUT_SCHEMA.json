        "host_class": {
          "enum": [
            null,
            "EXISTING_EXPECTED_BRIDGE",
            "HF_META_AP_SOUTHEAST_1_AWS_CDN_HF_CO",
            "HF_META_ASIA_SOUTHEAST1_US_GCP_CDN_HF_CO",
            "HF_META_AWS_CDN_HF_CO",
            "HF_META_CDN_LFS_EU_1_HF_CO",
            "HF_META_CDN_LFS_HF_CO",
            "HF_META_CDN_LFS_US_1_HF_CO",
            "HF_META_EUROPE_WEST4_US_GCP_CDN_HF_CO",
            "HF_META_EU_WEST_3_AWS_CDN_HF_CO",
            "HF_META_HF_CO",
            "HF_META_HUGGINGFACE_CN",
            "HF_META_HUGGINGFACE_CO",
            "HF_META_HUGGINGFACE_COM",
            "HF_META_TRANSFER_XETHUB_EU_HF_CO",
            "HF_META_TRANSFER_XETHUB_HF_CO",
            "HF_META_US_AWS_CDN_HF_CO",
            "HF_META_US_CENTRAL1_US_GCP_CDN_HF_CO",
            "HF_META_US_EAST1_US_GCP_CDN_HF_CO",
            "HF_META_US_EAST_1_AWS_CDN_HF_CO",
            "HF_META_US_GCP_CDN_HF_CO",
            "HF_META_US_WEST4_US_GCP_CDN_HF_CO",
