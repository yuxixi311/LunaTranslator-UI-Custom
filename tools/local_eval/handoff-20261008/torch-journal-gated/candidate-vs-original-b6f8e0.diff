+        call('FINAL_CHECKPOINT_FLUSH', 'FINAL_CHECKPOINT', handle.flush)
+        descriptor = call('FINAL_CHECKPOINT_FSYNC', 'FINAL_CHECKPOINT', handle.fileno)
